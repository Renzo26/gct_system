# ---- Backend ----
# Supabase: use SEMPRE o Session Pooler (IPv4, porta 5432), nunca a conexao direta (IPv6)
DATABASE_URL=postgresql+asyncpg://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

WAHA_BASE_URL=https://SEU-WAHA.easypanel.host
WAHA_API_KEY=sua-chave-waha
# Sessao padrao (fallback). Cada cliente tem a sua propria sessao cadastrada no sistema.
WAHA_SESSION=default

REDIS_URL=redis://default:SENHA@host-redis:6379

# Gere um novo por ambiente: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-por-um-segredo-de-256-bits

# Sem trailing slash. Precisa conter a URL exata do frontend.
CORS_ORIGINS=https://SEU-FRONT.easypanel.host

# Assistente de IA: deixe vazio para manter desativado.
ANTHROPIC_API_KEY=

APP_ENV=production
APP_PORT=8080

# ---- Frontend (build-time) ----
# Compilado no bundle: mudar exige rebuild da imagem, nao basta reiniciar.
VITE_API_URL=https://SUA-API.easypanel.host
